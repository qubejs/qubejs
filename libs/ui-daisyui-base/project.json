{
  "name": "ui-daisyui-base",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-daisyui-base/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "copy-scss": {
      "command": "node tools/scripts/copy-scss.mjs libs/ui-daisyui-base/src dist/libs/ui-daisyui-base",
      "dependsOn": [
        "build"
      ]
    },
    "build-scss": {
      "command": "node tools/scripts/build-scss.mjs libs/ui-daisyui-base/src"
    },
    "build-imports": {
      "command": "node tools/scripts/build-imports.mjs libs/ui-daisyui-base/src"
    },
    "dist": {
      "command": "node -v",
      "dependsOn": [
        "build-imports",
        "build-scss",
        "build",
        "copy-scss",
        "build-css"
      ]
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs ui-daisyui-base {args.ver} {args.tag}",
      "dependsOn": [
        "dist"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/ui-daisyui-base/jest.config.ts"
      }
    },
    "build-css": {
      "command": "node libs/ui-daisyui-base/postcss/build-css.cjs dist/libs/ui-daisyui-base/styles.css",
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/postcss/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/dist/libs/ui-daisyui-base/styles.css"
      ]
    }
  }
}
